# Reverse proxy for cmchub.net -> Node.js app on port 3000 (use certbot for HTTPS)
server {
    listen 80;
    server_name cmchub.net www.cmchub.net;
    return 301 https://cmchub.net$request_uri;
}
server {
    listen 443 ssl http2;
    server_name cmchub.net www.cmchub.net;
    ssl_certificate     /etc/letsencrypt/live/cmchub.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cmchub.net/privkey.pem;
    client_max_body_size 10m;

    location /_next/static/ {
        alias /var/www/cmchub/.next/static/;
        expires 365d;
        access_log off;
    }
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
